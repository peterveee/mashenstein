{
  "name": "mashenstein",
  "version": "0.1.0",
  "description": "MASHENSTEIN: THE UNPLUGGENING — a game stitched together from parts of other games.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build/build.js",
    "dev": "node build/dev.js",
    "dev:once": "node build/build.js --watch",
    "test": "node tests/run-all.js",
    "test:all": "node tests/run-all.js --all",
    "test:sound": "node tests/run-all.js --sound",
    "levels": "node tools/level-editor.js",
    "gallery": "node tools/build-gallery.js",
    "visualiser": "node tools/build-visualiser.js",
    "archive": "node tools/archive-release.js",
    "archive:gallery": "node tools/archive-gallery.js",
    "sim": "node tools/fairness-sim.js",
    "sim:economy": "node tools/economy-sim.js",
    "mixer": "node tools/mixer.js",
    "baseline": "node tools/make-baselines.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "playwright": "^1.61.1"
  },
  "dependencies": {
    "tone": "^15.1.22"
  }
}
