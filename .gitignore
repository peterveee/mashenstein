node_modules/

# Everything generated that is not the deployed site lives in one drawer, so the
# rule is a single line and the whole thing is safe to delete at any time:
#   work/renders/     every rendered wav — sfx cues, weapon candidates, audition
#                     sweeps. Regenerable from tools/ (render-sfx, render-cues,
#                     render-*-auditions); nothing loads it at runtime, the game
#                     synthesizes its audio live.
#   work/baselines/   ~260MB of engine reference renders for the null test —
#                     make with `npm run baseline`.
#   work/local/       throwaway verification shots and one-off scripts. Anything
#                     worth keeping goes to docs/shots/ instead.
#   work/mix-history/ every version of src/data/mix.js the mixer has overwritten —
#                     a safety net under a mixing session, not a second history
#                     beside git. ⋯ → Restore a previous save.
work/

# Build output. Separate from work/ because this one is the published site:
# .github/workflows/deploy-pages.yml uploads it as the Pages artifact.
dist/

# Two paths from before work/ existed, still ignored so nothing leaks into git
# while something is mid-flight: a mixer desk left running from before
# work/mix-history/, and a session still writing shots to the old local/.
# Both are safe to delete once nothing is using them.
.mix-history/
local/

.DS_Store
.playwright/
.playwright-mcp/
.env
tools/.venv-audio/
tools/.audition-recents.json
